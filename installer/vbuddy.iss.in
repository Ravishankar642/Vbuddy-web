; Generated by scripts/package.mjs from installer/vbuddy.iss.in. Do not edit the generated copy.
#define AppName "VBuddy"
#define AppVersion "@VERSION@"
#define AppPublisher "VBuddy"
#define StageDir "@STAGE@"

[Setup]
AppId={{B7F1C6D2-5C2E-4B3A-9D5E-7A1E0C4D8F21}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher={#AppPublisher}
DefaultDirName={autopf}\VBuddy
DefaultGroupName=VBuddy
DisableProgramGroupPage=yes
OutputDir=@OUT@
OutputBaseFilename=@OUTNAME@
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=admin
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
LicenseFile={#StageDir}\LICENSE.txt
SetupIconFile={#StageDir}\VBuddy.ico
UninstallDisplayIcon={app}\VBuddy.ico
CloseApplications=no

[Tasks]
@PLUGIN_TASK@Name: "startup"; Description: "Start VBuddy (in the notification area) when I sign in to Windows"; GroupDescription: "Startup:"
Name: "desktopicon"; Description: "Create a desktop shortcut"; GroupDescription: "Shortcuts:"

[Files]
Source: "{#StageDir}\*"; DestDir: "{app}"; Flags: recursesubdirs createallsubdirs ignoreversion
@PLUGIN_FILES@
[Icons]
Name: "{autoprograms}\VBuddy"; Filename: "{sys}\wscript.exe"; Parameters: """{app}\VBuddy.vbs"""; WorkingDir: "{app}"; IconFilename: "{app}\VBuddy.ico"
Name: "{autoprograms}\VBuddy with a window (for troubleshooting)"; Filename: "{app}\VBuddy.cmd"; WorkingDir: "{app}"; IconFilename: "{app}\VBuddy.ico"
Name: "{autoprograms}\VBuddy in the browser"; Filename: "{app}\Open VBuddy.cmd"; WorkingDir: "{app}"; IconFilename: "{app}\VBuddy.ico"
Name: "{autoprograms}\VBuddy settings"; Filename: "{app}\Edit settings.cmd"; WorkingDir: "{app}"
Name: "{autoprograms}\VBuddy find aircraft controls"; Filename: "{app}\Find aircraft controls.cmd"; WorkingDir: "{app}"
Name: "{autoprograms}\Uninstall VBuddy"; Filename: "{uninstallexe}"
Name: "{autodesktop}\VBuddy"; Filename: "{sys}\wscript.exe"; Parameters: """{app}\VBuddy.vbs"""; WorkingDir: "{app}"; IconFilename: "{app}\VBuddy.ico"; Tasks: desktopicon
Name: "{userstartup}\VBuddy"; Filename: "{sys}\wscript.exe"; Parameters: """{app}\VBuddy.vbs"" quiet"; WorkingDir: "{app}"; IconFilename: "{app}\VBuddy.ico"; Tasks: startup

[Run]
; Opens VBuddy's port (4789) and lets its own node.exe accept connections on every network type (home Wi-Fi is often "Public"). Rules Windows made earlier when a "Block" was chosen in its prompt are removed first.
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall delete rule name=""VBuddy"""; Flags: runhidden
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall delete rule name=""VBuddy program"""; Flags: runhidden
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall delete rule name=all program=""{app}\node\node.exe"""; Flags: runhidden
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall add rule name=""VBuddy"" dir=in action=allow protocol=TCP localport=4789 profile=any"; Flags: runhidden
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall add rule name=""VBuddy program"" dir=in action=allow program=""{app}\node\node.exe"" enable=yes profile=any"; Flags: runhidden
Filename: "{sys}\wscript.exe"; Parameters: """{app}\VBuddy.vbs"""; WorkingDir: "{app}"; Description: "Start VBuddy now (it runs in the notification area)"; Flags: postinstall nowait skipifsilent

[UninstallRun]
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall delete rule name=""VBuddy"""; Flags: runhidden; RunOnceId: "RemoveFirewallRule"
Filename: "{sys}\netsh.exe"; Parameters: "advfirewall firewall delete rule name=""VBuddy program"""; Flags: runhidden; RunOnceId: "RemoveProgramRule"

[UninstallDelete]
Type: filesandordirs; Name: "{app}"
Type: files; Name: "{userstartup}\VBuddy.lnk"

[Code]
{ Stops a running VBuddy first, so its files aren't locked while updating or removing. }
procedure StopVBuddy(const Dir: String);
var
  Code: Integer;
begin
  if FileExists(Dir + '\stop.ps1') then
    Exec(ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe'), '-NoProfile -ExecutionPolicy Bypass -File "' + Dir + '\stop.ps1"', '', SW_HIDE, ewWaitUntilTerminated, Code);
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  StopVBuddy(ExpandConstant('{app}'));
  Result := '';
end;

function InitializeUninstall(): Boolean;
begin
  StopVBuddy(ExpandConstant('{app}'));
  Result := True;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
    if not UninstallSilent then
      if MsgBox('Also delete your VBuddy flight log, landings and settings?' + #13#10 + '(' + ExpandConstant('{userappdata}') + '\VBuddy)', mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES then
      DelTree(ExpandConstant('{userappdata}') + '\VBuddy', True, True, True);
end;

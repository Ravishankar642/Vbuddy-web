[Unit]
Description=VBuddy relay
After=network-online.target
Wants=network-online.target

[Service]
User=vbuddy
WorkingDirectory=/opt/vbuddy
ExecStart=/usr/bin/node /opt/vbuddy/packages/relay/dist/index.js --port 8080 --host 127.0.0.1
Restart=always
RestartSec=3
# The relay needs nothing but a network port.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/vbuddy-relay
Environment=HOME=/var/lib/vbuddy-relay

[Install]
WantedBy=multi-user.target
